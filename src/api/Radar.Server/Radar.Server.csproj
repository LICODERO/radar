<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Radar.Scanner\Radar.Scanner.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Radar.Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- vault and skill templates, embedded so the app ships them and the client can never supply their text -->
    <EmbeddedResource Include="Features\Vault\Templates\*.md" />
  </ItemGroup>

</Project>
